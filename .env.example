
# PostgreSQL Connection String
# Format: postgresql://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/electrohack

# Admin console passkey (checked server-side only — never exposed to the frontend)
# Change this to your own secret before deploying.
ADMIN_SECRET=change_me_to_a_strong_secret

# Optional. Key used to encrypt team passwords at rest (AES-256-GCM) so an admin
# can view them again later without them ever being stored in plaintext. If unset,
# the encryption key is derived from ADMIN_SECRET instead — that works fine, but
# it means rotating ADMIN_SECRET will make every already-encrypted team password
# permanently undecryptable. Set this separately if you expect to rotate ADMIN_SECRET.
# TEAM_PASSWORD_ENC_SECRET=change_me_to_a_different_strong_secret

# Gemini API Key (Optional - for AI features)
# Get your API key from: https://ai.google.dev/
GEMINI_API_KEY=your_api_key_here

# Server Port (Optional - defaults to 3000)
PORT=3000

# Node Environment
NODE_ENV=development

# Frontend sessionStorage key used to persist the logged-in user (non-sensitive)
VITE_SESSION_STORAGE_KEY=embedcontrol_user_session

# Only needed when the frontend and backend are deployed to different origins
# (e.g. Cloudflare Pages serving the frontend, a Render web service serving the
# API). Leave unset for local dev and for the single-process deployment, where
# same-origin requests are correct. Set at BUILD time on the frontend host to
# the backend's full URL, e.g. https://your-app.onrender.com
# VITE_API_BASE_URL=https://your-app.onrender.com
