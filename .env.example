# PostgreSQL Connection String
# Format: postgresql://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/electrohack

# Admin console passkey (checked server-side only — never exposed to the frontend)
# Change this to your own secret before deploying.
ADMIN_SECRET=change_me_to_a_strong_secret

# Gemini API Key (Optional - for AI features)
# Get your API key from: https://ai.google.dev/
GEMINI_API_KEY=your_api_key_here

# Server Port (Optional - defaults to 3000)
PORT=3000

# Node Environment
NODE_ENV=development

# Frontend sessionStorage key used to persist the logged-in user (non-sensitive)
VITE_SESSION_STORAGE_KEY=embedcontrol_user_session
